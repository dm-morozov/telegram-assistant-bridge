# Render from current verified project container metadata; never install this placeholder file.
server {
    listen 127.0.0.1:18085;
    server_name telegram-bridge.mu56.ru;
    if ($host != telegram-bridge.mu56.ru) { return 421; }
    access_log off;
    client_max_body_size 16k;
    client_body_timeout 10s;
    location = /mcp {
        proxy_pass http://BRIDGE_CONTAINER_IPV4:3000;
        proxy_set_header Host telegram-bridge.mu56.ru;
        proxy_set_header Origin $http_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 20s;
    }
    location / { return 404; }
}
